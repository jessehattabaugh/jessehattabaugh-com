{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"composite": true,
		"rootDir": "..",
		"outDir": "../dist/types/node",
		"allowJs": true,
		"checkJs": true,
		"strict": true,
		"lib": ["ES2022"],
		"types": ["node"]
	},
	"include": ["../shared/html.js", "../shared/templates/**/*.js", "**/*.js", "../scripts/**/*.js"]
}
