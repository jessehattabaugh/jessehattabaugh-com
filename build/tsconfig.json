{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"composite": true,
		"rootDir": "..",
		"outDir": "../dist/types/node",
		"allowJs": true,
		"checkJs": true,
		"strict": true,
		"lib": [
			"ES2022"
		],
		"types": [
			"node"
		]
	},
	"include": [
		"../shared/**/*.js",
		"../site/pages.js",
		"../site/data/**/*.js",
		"../site/templates/**/*.js",
		"**/*.js",
		"../scripts/**/*.js",
		"../apps/*/templates.js",
		"../apps/*/model.js",
		"../apps/*/data.js"
	]
}
