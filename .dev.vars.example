# Copy to .dev.vars. Never commit .dev.vars or paste secrets into chat.
# Node scripts and Playwright load this automatically; Wrangler uses it for dev.
# Leave optional values empty. CI/environment values take precedence.

# Cloudflare tooling: OAuth login is sufficient for deployment.
# Optional API-token deployment needs Workers Scripts write and D1 write.
# Use the separate E2E token below for D1-only test credentials.
# These tooling credentials are NEVER uploaded as Worker variables or secrets.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Stateful E2E fixture setup/cleanup: scoped token with D1 read/write only.
E2E_CLOUDFLARE_API_TOKEN=

# Optional real delivery suite: a catch-all mailbox domain you control.
# Verification emails are sent only when this flag is 1, preserving the daily allowance.
E2E_EMAIL_FLOW=0
E2E_EMAIL_DOMAIN=

# Public Worker settings. Deployment copies only these allow-listed settings.
EMAIL_FROM=no-reply@notify.jessehattabaugh.com
VAPID_CONTACT=mailto:notifications@jessehattabaugh.com
# Optional OSRM-compatible HTTPS endpoint; empty uses public OSRM.
OSRM_URL=

# Public identity only; no app password or AT Protocol token is needed.
ATPROTO_HANDLE=jessehattabaugh.com
# Canonical production origin for sitemap and document canonical links, even on previews.
SITE_ORIGIN=https://jessehattabaugh.com

# Optional Cloudflare Web Analytics. In Manage Site, keep automatic injection
# enabled with EU visitor data excluded.
# https://developers.cloudflare.com/web-analytics/get-started/#sites-proxied-through-cloudflare
#
# Account ID for the Cloudflare account that owns the Web Analytics property.
# https://developers.cloudflare.com/fundamentals/account/find-account-and-zone-ids/
WEB_COUNTER_ACCOUNT_ID=
# Property identifier from the site's site_tag field in the List Web Analytics
# sites API response. The lookup requires Account Settings Read.
# https://developers.cloudflare.com/api/resources/rum/subresources/site_info/methods/list/
WEB_COUNTER_SITE_TAG=

# Worker runtime secrets. Needed locally for the corresponding capabilities.
# Remote deployments preserve existing Cloudflare secrets; changing this file
# alone does not rotate them. Use secrets:upload to upload only this allow-list.
# SESSION_SECRET: random 32+ bytes, base64url, required for signed account sessions.
SESSION_SECRET=
# Optional Web Push keys, generated together by build/generate-vapid-keys.js.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional one-time credential for claiming the owner role.
OWNER_SETUP_TOKEN=
# Secret used by the Worker to query page views for the counter and dashboard.
# Create an account API token named web-counter. Select Account → Account
# Analytics → Read. The summary lists Account Analytics Read.
# https://developers.cloudflare.com/analytics/graphql-api/getting-started/authentication/api-token-auth/
# Store the deployed value as a Worker secret with this same name.
# https://developers.cloudflare.com/workers/configuration/secrets/
WEB_COUNTER_API_TOKEN=

# Optional overrides for npm test; otherwise branch identity supplies these.
WORKERS_DEV_SUBDOMAIN=billowing-sunset-4e06
PREVIEW_URL=
# Database identity must match the actual preview; generated by deployment/tests.
# Do not put production database names here.
PREVIEW_DB_NAME=

# Optional branch override for detached CI builds; normally supplied by Workers Builds.
WORKERS_CI_BRANCH=
CF_PAGES_BRANCH=
