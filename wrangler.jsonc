{
	"assets": { "binding": "ASSETS", "directory": "./dist/client/" },
	"compatibility_date": "2026-05-01",
	"d1_databases": [
		{
			"binding": "DB",
			"database_id": "bc840c22-76e5-433b-8319-a98ee3ae3cc4",
			"database_name": "jessehattabaugh-com",
			"migrations_dir": "db/migrations"
		},
		{
			"binding": "jessehattabaugh_com_preview_214_messages_app_is_blank_after_registering",
			"database_name": "jessehattabaugh-com-preview-214-messages-app-is-blank-after-registering",
			"database_id": "e6cdb609-2cb7-4eb5-b402-745032821680",
			"remote": true
		}
	],
	"main": "./worker/index.js",
	"name": "jessehattabaugh-com",
	"observability": { "enabled": true },
	"preview_urls": true,
	"send_email": [
		{
			"name": "EMAIL",
			"allowed_sender_addresses": [
				"no-reply@jessehattabaugh.com",
				"messages@jessehattabaugh.com"
			]
		}
	],
	"routes": [
		{ "custom_domain": true, "pattern": "jessehattabaugh.com" },
		{ "custom_domain": true, "pattern": "www.jessehattabaugh.com" }
	],
	// Non-secret config. Secrets are set via: wrangler secret put <NAME>
	// Required secrets:
	//   SESSION_SECRET     — random 32+ bytes, base64url-encoded
	//   VAPID_PUBLIC_KEY   — P-256 uncompressed public key, base64url (65 bytes)
	//   VAPID_PRIVATE_KEY  — P-256 PKCS8 private key, base64url
	//   OWNER_SETUP_TOKEN  — any secret string; used once to mark Jesse as owner
	//
	// Generate VAPID keys with Node.js:
	//   node scripts/generate-vapid-keys.js
	//
	// Email Service: onboarding required before sending. Run once per account:
	//   npx wrangler email sending enable jessehattabaugh.com
	"vars": {
		"VAPID_CONTACT": "mailto:claude_ai@jessehattabaugh.com",
		"EMAIL_FROM": "no-reply@jessehattabaugh.com"
	}
}