{
	"assets": { "binding": "ASSETS", "directory": "./dist/client/", "run_worker_first": true },
	"compatibility_date": "2026-05-01",
	"d1_databases": [
		{
			"binding": "DB",
			"database_id": "bc840c22-76e5-433b-8319-a98ee3ae3cc4",
			"database_name": "jessehattabaugh-com",
			"migrations_dir": "db/migrations"
		}
	],
	"main": "./worker/index.js",
	"name": "jessehattabaugh-com",
	"observability": { "enabled": true },
	"preview_urls": true,
	"secrets": { "required": ["SESSION_SECRET"] },
	"send_email": [
		{
			"name": "EMAIL",
			"allowed_sender_addresses": [
				"no-reply@notify.jessehattabaugh.com",
				"messages@jessehattabaugh.com"
			]
		}
	],
	"routes": [
		{ "custom_domain": true, "pattern": "jessehattabaugh.com" },
		{ "custom_domain": true, "pattern": "www.jessehattabaugh.com" }
	],
	// Rainbow Hour wake cron: push a "check the sky" wake-up to devices whose
	// sun is inside the rainbow band. Crons only fire on the active (production)
	// deployment — preview versions uploaded for branches never run this.
	"triggers": {
		"crons": ["*/15 * * * *"]
	}
}
