{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowJs": true,
		"checkJs": true,
		"strict": true,
		"noEmit": true,
		"lib": ["ES2022"],
		"types": ["node"]
	},
	"include": ["shared/html.js", "shared/templates/**/*.js", "build/**/*.js", "scripts/**/*.js"]
}
