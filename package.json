{
	"devDependencies": {
		"@cloudflare/workers-types": "latest",
		"@eslint/compat": "latest",
		"@eslint/eslintrc": "latest",
		"@eslint/js": "latest",
		"@parcel/plugin": "3.0.0-alpha.2",
		"@playwright/test": "latest",
		"@types/node": "latest",
		"eslint": "latest",
		"globals": "14.0.0",
		"lighthouse": "latest",
		"parcel": "3.0.0-alpha.2",
		"sharp": "0.35.4",
		"typescript": "latest",
		"wrangler": "latest"
	},
	"name": "jessehattabaugh-com",
	"scripts": {
		"build": "node build/build.js",
		"check": "tsc --project server/tsconfig.json --noEmit && tsc --project build/tsconfig.json --noEmit && tsc --project client/tsconfig.json --noEmit && tsc --project client/tsconfig.service-workers.json --noEmit",
		"deploy": "node build/deploy.js",
		"deploy:prod": "node build/deploy.js --production",
		"deploy:preview": "node build/deploy.js --preview",
		"dev": "wrangler dev",
		"test": "node test/run-preview.js",
		"secrets:upload": "node build/upload-secrets.js",
		"lint": "eslint . --max-warnings 0"
	},
	"type": "module",
	"version": "1.0.0",
	"allowScripts": {
		"esbuild@0.28.2": true,
		"workerd@1.20261101.1": true
	},
	"private": true,
	"browserslist": "last 2 Chrome versions, last 2 Firefox versions, last 2 Safari versions",
	"targets": {
		"production": {
			"context": "browser",
			"outputFormat": "esmodule",
			"distDir": "./dist/client",
			"optimize": true
		}
	},
	"exports": {
		"./components/disclosure-panel": {
			"source": "./client/shared/components/disclosure-panel/index.js",
			"production": "./dist/client/components/disclosure-panel/index.js"
		},
		"./components/disclosure-panel/element": {
			"source": "./client/shared/components/disclosure-panel/disclosure-panel.js",
			"production": "./dist/client/components/disclosure-panel/disclosure-panel.js"
		},
		"./components/rpg-actor": {
			"source": "./client/shared/components/rpg-actor/index.js",
			"production": "./dist/client/components/rpg-actor/index.js"
		},
		"./components/rpg-actor/element": {
			"source": "./client/shared/components/rpg-actor/rpg-actor.js",
			"production": "./dist/client/components/rpg-actor/rpg-actor.js"
		}
	}
}
