{
	"devDependencies": {
		"@cloudflare/workers-types": "latest",
		"@custom-elements-manifest/analyzer": "^0.11.0",
		"@eslint/compat": "latest",
		"@eslint/eslintrc": "latest",
		"@eslint/js": "latest",
		"@playwright/test": "latest",
		"@types/node": "latest",
		"ajv": "^8.20.0",
		"comment-parser": "^1.2.4",
		"custom-elements-manifest": "^1.0.0",
		"eslint": "latest",
		"globals": "latest",
		"lighthouse": "latest",
		"sharp": "latest",
		"typescript": "latest",
		"wrangler": "latest"
	},
	"name": "jessehattabaugh-com",
	"scripts": {
		"build": "npm run cem:check && node build/build.js",
		"check": "tsc --project server/tsconfig.json --noEmit && tsc --project build/tsconfig.json --noEmit && tsc --project client/tsconfig.json --noEmit && tsc --project client/tsconfig.service-workers.json --noEmit && npm run cem:check",
		"deploy": "node build/deploy.js",
		"deploy:prod": "node build/deploy.js --production",
		"deploy:preview": "node build/deploy.js --preview",
		"dev": "wrangler dev",
		"test": "node test/run-preview.js",
		"secrets:upload": "node build/upload-secrets.js",
		"lint": "eslint . --max-warnings 0",
		"cem:generate": "node build/custom-elements.js",
		"cem:check": "node build/custom-elements.js --check"
	},
	"type": "module",
	"version": "1.0.0",
	"allowScripts": {
		"esbuild@0.28.2": true,
		"workerd@1.20261104.1": true
	},
	"private": true,
	"exports": {
		"./components/web-counter": "./client/components/web-counter/index.js",
		"./components/disclosure-panel": "./client/components/disclosure-panel/index.js",
		"./components/disclosure-panel/element": "./client/components/disclosure-panel/disclosure-panel.js",
		"./components/game-kit": "./client/components/game-kit/index.js",
		"./components/rpg-actor": "./client/components/rpg-actor/index.js",
		"./components/rpg-actor/element": "./client/components/rpg-actor/rpg-actor.js",
		"./components/game-kit/world-data": "./client/components/game-kit/world-data.js",
		"./components/game-kit/game-input": "./client/components/game-kit/game-input.js",
		"./components/game-kit/world-renderer": "./client/components/game-kit/world-renderer.js",
		"./components/game-kit/world": "./client/components/game-kit/world.js",
		"./custom-elements.json": "./custom-elements.json",
		"./components/code-block": "./client/components/code-block/index.js"
	},
	"dependencies": {
		"@highlightjs/cdn-assets": "11.12.0",
		"hono": "^4.13.16"
	},
	"customElements": "./custom-elements.json"
}