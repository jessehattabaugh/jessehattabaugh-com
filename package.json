{
	"devDependencies": {
		"@cloudflare/workers-types": "latest",
		"@eslint/compat": "latest",
		"@eslint/eslintrc": "latest",
		"@eslint/js": "latest",
		"@playwright/test": "latest",
		"@types/node": "latest",
		"eslint": "latest",
		"lighthouse": "latest",
		"sharp": "0.35.4",
		"typescript": "latest",
		"wrangler": "latest",
		"globals": "14.0.0"
	},
	"name": "jessehattabaugh-com",
	"scripts": {
		"build": "node build/build.js",
		"check": "tsc --project worker/tsconfig.json --noEmit && tsc --project build/tsconfig.json --noEmit && tsc --project client/tsconfig.json --noEmit",
		"deploy": "node scripts/deploy.js",
		"deploy:prod": "node scripts/deploy.js --production",
		"deploy:preview": "node scripts/deploy.js --preview",
		"dev": "wrangler dev",
		"test": "node scripts/test-preview.js",
		"secrets:upload": "node scripts/upload-secrets.js",
		"lint": "eslint . --max-warnings 0"
	},
	"type": "module",
	"version": "1.0.0"
}
