{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"composite": true,
		"outDir": "../dist/types/client",
		"rootDir": "..",
		"allowJs": true,
		"checkJs": true,
		"strict": true,
		"lib": [
			"ES2022",
			"DOM",
			"DOM.Iterable"
		],
		"types": []
	},
	"include": [
		"**/*.js",
		"../shared/rainbow-hour/**/*.js",
		"../shared/code-highlight.js"
	],
	"exclude": [
		"apps/*/sw.js"
	]
}
