{
	"private": true,
	"type": "module",
	"source": [
		"apps/*/app.js",
		"enhance/index.js",
		"components/*demo.js",
		"components/*/docs/index.js",
		"**/*.css",
		"**/*.svg",
		"apps/*/manifest.webmanifest",
		"**/offline.html",
		"games/**/*.png"
	],
	"targets": {
		"default": {
			"context": "browser",
			"outputFormat": "esmodule",
			"distDir": "../dist/client"
		}
	},
	"browserslist": "last 2 Chrome versions, last 2 Firefox versions, last 2 Safari versions"
}
