{
	"name": "Jessages — Messages to Jesse",
	"short_name": "Jessages",
	"description": "Messages to Jesse. Install this app to be notified of replies.",
	"start_url": "/apps/messages/?pwa=1",
	"scope": "/apps/messages/",
	"display": "standalone",
	"orientation": "any",
	"theme_color": "#06b6d4",
	"background_color": "#06b6d4",
	"icons": [
		{
			"src": "/apps/messages/icon.svg",
			"sizes": "any",
			"type": "image/svg+xml",
			"purpose": "any"
		},
		{
			"src": "/apps/messages/icon-192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "any maskable"
		},
		{
			"src": "/apps/messages/icon-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "any maskable"
		}
	],
	"share_target": {
		"action": "/apps/messages/",
		"method": "POST",
		"enctype": "multipart/form-data",
		"params": { "title": "title", "text": "text", "url": "url" }
	},
	"shortcuts": [
		{
			"name": "Send a message",
			"url": "/apps/messages/",
			"icons": [{ "src": "/apps/messages/icon.svg", "sizes": "any" }]
		}
	]
}
