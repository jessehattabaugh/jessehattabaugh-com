{
	"extends": "@parcel/config-default",
	"namers": [
		"./build/parcel-namer.js",
		"..."
	],
	"resolvers": [
		"./build/parcel-resolver.js",
		"..."
	],
	"transformers": {
		"**/build/site.json": [
			"./build/parcel-site.js"
		],
		"generated:*.html": [
			"./build/parcel-generated.js",
			"@parcel/transformer-html"
		],
		"generated:*.svg": [
			"./build/parcel-generated.js",
			"@parcel/transformer-svg"
		],
		"generated:*.xml": [
			"./build/parcel-generated.js",
			"@parcel/transformer-xml"
		],
		"generated:*": [
			"./build/parcel-generated.js"
		],
		"raw:*.json": [
			"./build/parcel-json.js"
		],
		"raw:*": [
			"@parcel/transformer-raw"
		]
	}
}
